{
  "name": "lumis-run-3d",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:site": "npm run build:server && tsc -b && vite build --mode site --outDir ../../public/lumis-run --emptyOutDir",
    "build:server": "esbuild server/handler.ts --bundle --format=esm --platform=neutral --target=es2022 --legal-comments=none --banner:js='// GERADO por jogos/lumis-run (npm run build:server). Não edite.' --outfile=../../supabase/functions/lumis-run/handler.js",
    "server:local": "node scripts/local-server.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "qrcode-generator": "^1.4.4",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
