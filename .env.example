# Chaves de IA (use UMA delas). Ao hospedar (Vercel, Cloudflare, Lovable), cadastre
# a mesma variável no painel da hospedagem. O .env nunca deve ir para o GitHub.

# Grátis — crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: trocar o modelo do Gemini
# GEMINI_MODEL=gemini-3.8-flash

# Pago (opcional) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
